# systemd 服务模板（Node 版）。用法：
#   1) 把本工程解压到 /opt/cli-proxy-logger（或改下面的 WorkingDirectory/ExecStart 路径）
#   2) 按需改 Environment 里的端口/上游/日志目录
#   3) sudo cp deploy/cli-proxy-logger.service /etc/systemd/system/
#   4) sudo systemctl daemon-reload && sudo systemctl enable --now cli-proxy-logger
#   查看日志：journalctl -u cli-proxy-logger -f
[Unit]
Description=cli-proxy-logger (Node) - local LLM proxy logger
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/cli-proxy-logger
# node 的绝对路径按实际改（which node）。
ExecStart=/usr/bin/node /opt/cli-proxy-logger/src/index.js
Restart=on-failure
RestartSec=2
# —— 可选环境变量（去掉注释即可生效）——
Environment=PROXY_PORT=8788
Environment=UI_PORT=8789
Environment=LOG_DIR=/var/log/cli-proxy-logger
Environment=OPENAI_UPSTREAM=https://api.openai.com
Environment=ANTHROPIC_UPSTREAM=https://api.anthropic.com
# 建议用非 root 跑（先 useradd -r cliproxy）：
# User=cliproxy

[Install]
WantedBy=multi-user.target
